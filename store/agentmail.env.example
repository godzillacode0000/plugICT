# AgentMail configuration for local/manual PlugICT fulfilment.
# NEVER commit a real API key or paste it into chat.
# Canonical seller vault artifacts (.vault_key, .vault_sha256, ict-vault.kevin).
ICT_BUILD_DIR=D:/PlugICT

PLUGICT_EMAIL_PROVIDER=agentmail
AGENTMAIL_API_KEY=[REDACTED]
AGENTMAIL_INBOX=orders-test@agentmail.to
AGENTMAIL_API_BASE_URL=https://api.agentmail.to/v0
AGENTMAIL_TIMEOUT_SECONDS=30

# Buyer replies can remain on the existing human support mailbox.
AGENTMAIL_REPLY_TO=support@plugict.com

# Optional seller blind copy. Leave blank/off if not wanted.
LICENSE_BCC=support@plugict.com

# Existing product URLs used by store/emails.py.
ICT_VAULT_DOWNLOAD_URL=https://github.com/godzillacode0000/plugICT/releases/latest
ICT_GETTING_STARTED_URL=https://godzillacode0000.github.io/plugICT/#setup
ICT_SUPPORT_EMAIL=support@plugict.com
